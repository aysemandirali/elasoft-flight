@model List<FlightBooking.Dtos.BookingDtos.ResultBookingDto>
@{
    Layout = "~/Areas/Admin/Views/Layout/AdminLayout.cshtml";
    ViewData["Title"] = "Rezervasyonlar";
}

<div class="main-content" id="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="m-0"><i class="bi bi-journals"></i> Rezervasyonlar</h3>
        <a asp-action="CreateBooking" class="btn btn-success"><i class="bi bi-plus-circle"></i> Yeni Rezervasyon</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">Henüz rezervasyon yok. "Yeni Rezervasyon" ile ekleyebilirsin.</div>
    }
    else
    {
        <div class="table-responsive card shadow-sm">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th>PNR</th>
                        <th>İletişim</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Yolcu</th>
                        <th>Tutar</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>Ödeme</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><span class="badge bg-dark">@b.PnrNumber</span></td>
                            <td>@b.ContactName</td>
                            <td>@b.ContactEmail</td>
                            <td>@b.ContactPhone</td>
                            <td>@b.PassengerCount</td>
                            <td>@b.TotalPrice.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ₺</td>
                            <td>@b.BookingDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><span class="badge bg-success">@(b.Status == "Confirmed" ? "Onaylandı" : b.Status == "Cancelled" ? "İptal Edildi" : b.Status)</span></td>
                            <td>
                                @if (b.PaymentStatus == "Ödendi")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Ödendi</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Bekliyor</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
