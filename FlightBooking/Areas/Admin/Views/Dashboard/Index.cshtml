@{
    Layout = "~/Areas/Admin/Views/Layout/AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="main-content" id="main-content">
    <h3 class="mb-1"><i class="bi bi-grid-1x2-fill"></i> Genel Bakış</h3>
    <p class="text-muted mb-4">Sistemdeki güncel özet bilgiler.</p>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Toplam Uçuş</div>
                    <div class="display-6 fw-bold text-primary">@ViewBag.FlightCount</div>
                    <div class="small text-secondary">@ViewBag.Scheduled planlı · @ViewBag.Delayed gecikmeli</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Rezervasyon</div>
                    <div class="display-6 fw-bold text-success">@ViewBag.BookingCount</div>
                    <div class="small text-secondary">@ViewBag.PassengerTotal yolcu</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Toplam Gelir</div>
                    <div class="display-6 fw-bold text-dark">@ViewBag.Revenue</div>
                    <div class="small text-secondary">tüm rezervasyonlar</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">No-Show Kaydı</div>
                    <div class="display-6 fw-bold text-info">@ViewBag.NoShowCount</div>
                    <div class="small text-secondary">ML için geçmiş veri</div>
                </div>
            </div>
        </div>
    </div>

    <h6 class="text-muted mb-3">Hızlı Erişim</h6>
    <div class="row g-3">
        <div class="col-md-4"><a href="/Admin/Flights/FlightList" class="btn btn-outline-primary w-100 py-3"><i class="bi bi-airplane"></i> Uçuş Yönetimi</a></div>
        <div class="col-md-4"><a href="/Admin/Booking/BookingList" class="btn btn-outline-success w-100 py-3"><i class="bi bi-journals"></i> Rezervasyonlar</a></div>
        <div class="col-md-4"><a href="/Admin/CheckIn/Index" class="btn btn-outline-secondary w-100 py-3"><i class="bi bi-ticket-perforated"></i> Online Check-in</a></div>
        <div class="col-md-4"><a href="/Admin/OverBooking/Index" class="btn btn-outline-dark w-100 py-3"><i class="bi bi-graph-up-arrow"></i> Overbooking Önerisi</a></div>
        <div class="col-md-4"><a href="/Admin/Forecast/Index" class="btn btn-outline-info w-100 py-3"><i class="bi bi-cpu"></i> No-Show Tahmini (ML)</a></div>
        <div class="col-md-4"><a href="/Agent/Index" class="btn btn-outline-primary w-100 py-3"><i class="bi bi-robot"></i> AI Asistan</a></div>
    </div>
</div>
