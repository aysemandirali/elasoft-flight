@{
    Layout = "~/Areas/Admin/Views/Layout/AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="main-content" id="main-content">

    <!-- Sayfa başlığı -->
    <div class="page-header">
        <div>
            <div class="page-breadcrumb">
                <i class="bi bi-house"></i> <span>Yönetim</span> <span class="sep">›</span> <span>Genel Bakış</span>
            </div>
            <h1 class="page-title">Genel Bakış</h1>
            <p class="page-desc">Sistemdeki güncel özet bilgiler ve hızlı erişim.</p>
        </div>
        <a href="/Admin/Flights/CreateFlight" class="btn-add"><i class="bi bi-plus-lg"></i> Yeni Uçuş</a>
    </div>

    <!-- İstatistik kartları -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-airplane-fill"></i></div>
            <div>
                <div class="stat-value">@ViewBag.FlightCount</div>
                <div class="stat-label">Toplam Uçuş</div>
                <div class="stat-change up"><i class="bi bi-check-circle"></i> @ViewBag.Scheduled planlı · @ViewBag.Delayed gecikmeli</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-ticket-detailed-fill"></i></div>
            <div>
                <div class="stat-value">@ViewBag.BookingCount</div>
                <div class="stat-label">Rezervasyon</div>
                <div class="stat-change up"><i class="bi bi-people"></i> @ViewBag.PassengerTotal yolcu</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="stat-value">@ViewBag.Revenue ₺</div>
                <div class="stat-label">Toplam Gelir</div>
                <div class="stat-change up"><i class="bi bi-graph-up-arrow"></i> tüm rezervasyonlar</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-person-x-fill"></i></div>
            <div>
                <div class="stat-value">@ViewBag.NoShowCount</div>
                <div class="stat-label">No-Show Kaydı</div>
                <div class="stat-change down"><i class="bi bi-cpu"></i> ML için geçmiş veri</div>
            </div>
        </div>
    </div>

    <!-- Hızlı erişim -->
    <div class="table-card">
        <div class="table-card-header">
            <h2 style="font-family:'Syne',sans-serif; font-size:16px; font-weight:700; color:var(--navy); margin:0;">Hızlı Erişim</h2>
        </div>
        <div style="padding:22px 24px;">
            <div class="quick-grid">
                <a class="quick-tile" href="/Admin/Flights/FlightList">
                    <span class="qt-icon blue"><i class="bi bi-airplane"></i></span>
                    <span class="qt-text"><strong>Uçuş Yönetimi</strong><small>Uçuşları listele, ekle, düzenle</small></span>
                </a>
                <a class="quick-tile" href="/Admin/Booking/BookingList">
                    <span class="qt-icon green"><i class="bi bi-journals"></i></span>
                    <span class="qt-text"><strong>Rezervasyonlar</strong><small>Tüm rezervasyon kayıtları</small></span>
                </a>
                <a class="quick-tile" href="/Admin/Passengers/Index">
                    <span class="qt-icon blue"><i class="bi bi-people"></i></span>
                    <span class="qt-text"><strong>Yolcular</strong><small>Tüm yolcu listesi</small></span>
                </a>
                <a class="quick-tile" href="/Admin/CheckIn/Index">
                    <span class="qt-icon orange"><i class="bi bi-ticket-perforated"></i></span>
                    <span class="qt-text"><strong>Online Check-in</strong><small>Yolcu check-in işlemleri</small></span>
                </a>
                <a class="quick-tile" href="/Admin/OverBooking/Index">
                    <span class="qt-icon red"><i class="bi bi-graph-up-arrow"></i></span>
                    <span class="qt-text"><strong>Overbooking Önerisi</strong><small>Fazla satış analizi</small></span>
                </a>
                <a class="quick-tile" href="/Agent/Index">
                    <span class="qt-icon blue"><i class="bi bi-robot"></i></span>
                    <span class="qt-text"><strong>AI Asistan</strong><small>Seyahat asistanına sor</small></span>
                </a>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <style>
        .quick-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .quick-tile {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 18px;
            border: 1px solid var(--gray-100);
            border-radius: var(--radius);
            background: var(--white);
            text-decoration: none;
            transition: box-shadow var(--transition), transform var(--transition), border-color var(--transition);
        }

            .quick-tile:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-2px);
                border-color: var(--accent);
            }

        .qt-icon {
            width: 44px;
            height: 44px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            flex-shrink: 0;
        }

            .qt-icon.blue { background: rgba(30,111,217,.1); color: var(--accent); }
            .qt-icon.green { background: rgba(16,185,129,.1); color: #10B981; }
            .qt-icon.orange { background: rgba(245,158,11,.1); color: #F59E0B; }
            .qt-icon.red { background: rgba(239,68,68,.1); color: #EF4444; }

        .qt-text { display: flex; flex-direction: column; }
            .qt-text strong { font-size: 14px; color: var(--navy); font-weight: 600; }
            .qt-text small { font-size: 12px; color: var(--gray-500); margin-top: 2px; }

        @@media (max-width: 991px) { .quick-grid { grid-template-columns: repeat(2, 1fr); } }
        @@media (max-width: 560px) { .quick-grid { grid-template-columns: 1fr; } }
    </style>
}
