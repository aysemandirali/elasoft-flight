@using FlightBooking.Dtos.OverBookingDtos
@{
    Layout = "~/Areas/Admin/Views/Layout/AdminLayout.cshtml";
    ViewData["Title"] = "Overbooking Önerisi";
    var rates = ViewBag.Rates as Dictionary<string, double> ?? new Dictionary<string, double>();
    var recordCount = (int)(ViewBag.RecordCount ?? 0);
    var result = ViewBag.Result as OverbookingRecommendationResult;
}

<div class="main-content" id="main-content">
    <h3 class="mb-4"><i class="bi bi-graph-up-arrow"></i> Overbooking Önerisi</h3>

    @if (TempData["SeedMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SeedMessage"]</div>
    }

    @if (recordCount == 0)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <span>Henüz geçmiş no-show verisi yok. Öneri hesaplamak için örnek veri yükleyin.</span>
            <form asp-action="Seed" method="post" class="m-0">
                <button class="btn btn-primary btn-sm"><i class="bi bi-database-add"></i> Örnek Veri Yükle</button>
            </form>
        </div>
    }
    else
    {
        <p class="text-muted">Geçmiş kayıt sayısı: <strong>@recordCount</strong></p>

        <div class="row">
            <div class="col-md-5">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light"><strong>Slot Bazlı No-Show Oranları</strong></div>
                    <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="table-light"><tr><th>Slot</th><th>No-Show Oranı</th></tr></thead>
                        <tbody>
                            @foreach (var kv in rates.OrderByDescending(x => x.Value))
                            {
                                <tr><td>@kv.Key</td><td><span class="badge bg-info text-dark">%@kv.Value</span></td></tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light"><strong>Öneri Hesapla</strong></div>
                    <div class="card-body">
                        <form asp-action="Recommend" method="post" class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label">Slot</label>
                                <select name="flightSlot" class="form-select" required>
                                    @foreach (var kv in rates)
                                    {
                                        <option value="@kv.Key">@kv.Key</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Tahmini Yolcu</label>
                                <input name="forecastPassenger" type="number" class="form-control" value="210" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Kapasite</label>
                                <input name="capacity" type="number" class="form-control" value="220" required />
                            </div>
                            <div class="col-md-1">
                                <button class="btn btn-primary w-100"><i class="bi bi-calculator"></i></button>
                            </div>
                        </form>
                    </div>
                </div>

                @if (result != null)
                {
                    var badgeClass = result.RiskLevel == "High" ? "bg-danger" : result.RiskLevel == "Medium" ? "bg-warning text-dark" : "bg-success";
                    <div class="card shadow-sm">
                        <div class="card-header bg-dark text-white"><strong>Sonuç — @result.FlightSlot</strong></div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col"><div class="text-muted small">No-Show Oranı</div><div class="fs-5 fw-bold">%@result.ExpectedNoShowRate</div></div>
                                <div class="col"><div class="text-muted small">Beklenen No-Show</div><div class="fs-5 fw-bold">@result.ExpectedNoShowPassenger</div></div>
                                <div class="col"><div class="text-muted small">Önerilen Max Satış</div><div class="fs-5 fw-bold text-primary">@result.RecommendedMaxTicketSale</div></div>
                                <div class="col"><div class="text-muted small">Ekstra Koltuk</div><div class="fs-5 fw-bold text-success">+@result.ExtraSellableSeatCount</div></div>
                            </div>
                            <hr />
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @badgeClass">Risk: @result.RiskLevel</span>
                                <span>@result.Recommendation</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
