<!-- ================================================================
       TOPBAR
  ================================================================ -->
<header class="topbar" id="topbar">

    <!-- Search -->
    <div class="topbar-search">
        <i class="bi bi-search search-icon"></i>
        <input type="text" placeholder="Uçuş, yolcu, rezervasyon ara…" />
    </div>

    <div class="topbar-spacer"></div>

    <!-- Notifications -->
    @{
        var notifs = ViewBag.Notifications as List<(string Icon, string Color, string Text)> ?? new();
        var notifCount = (int)(ViewBag.NotifCount ?? 0);
    }
    <div class="dd-wrapper">
        <button class="tb-icon-btn" onclick="toggleDD('notif-dd')">
            <i class="bi bi-bell-fill"></i>
            @if (notifCount > 0)
            {
                <span class="tb-badge count">@notifCount</span>
            }
        </button>
        <div class="dropdown-menu-custom" id="notif-dd">
            <div style="padding:8px 12px 6px;font-size:11px;font-weight:700;color:var(--gray-500);letter-spacing:.6px;text-transform:uppercase;">Bildirimler</div>
            @if (notifs.Count == 0)
            {
                <div style="padding:14px 12px;font-size:13px;color:var(--gray-500);text-align:center;">Yeni bildirim yok</div>
            }
            else
            {
                @foreach (var n in notifs)
                {
                    <a href="/Admin/Flights/FlightList"><i class="bi @n.Icon" style="color:@n.Color;"></i>@n.Text</a>
                }
                <div class="divider"></div>
                <a href="/Admin/Flights/FlightList" style="justify-content:center;color:var(--accent);font-weight:600;">Uçuşlara Git</a>
            }
        </div>
    </div>

    <!-- AI Asistan -->
    <a href="/Agent/Index" class="tb-icon-btn" title="AI Asistan" style="text-decoration:none;">
        <i class="bi bi-robot"></i>
    </a>

    <!-- User -->
    <div class="dd-wrapper">
        <button class="user-pill" onclick="toggleDD('user-dd')">
            <div class="user-avatar">AM</div>
            <div class="user-info">
                <span class="user-name">@(User.Identity?.IsAuthenticated == true ? User.Identity!.Name : "Ayse Mandirali")</span>
                <span class="user-role">Süper Admin</span>
            </div>
            <i class="bi bi-chevron-down" style="font-size:11px;color:var(--gray-500);margin-left:4px;"></i>
        </button>
        <div class="dropdown-menu-custom" id="user-dd">
            <a href="/Admin/Profile/Index"><i class="bi bi-person-fill"></i>Profilim</a>
            <a href="/Admin/Settings/Index"><i class="bi bi-gear-fill"></i>Ayarlar</a>
            <div class="divider"></div>
            <a href="/"><i class="bi bi-house-door"></i>Ana Siteye Dön</a>
            <a href="/Account/Logout" class="danger"><i class="bi bi-box-arrow-right"></i>Çıkış Yap</a>
        </div>
    </div>

</header>