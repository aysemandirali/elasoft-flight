@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yönetim Paneli Girişi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            font-family: 'DM Sans', sans-serif;
            background: radial-gradient(1200px 600px at 20% -10%, #16305e 0%, transparent 60%), #0B1B3A;
        }

        .admin-card {
            background: #102040;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 18px;
            box-shadow: 0 20px 60px rgba(0,0,0,.45);
            color: #E8ECF4;
        }

        .brand-badge {
            width: 54px;
            height: 54px;
            border-radius: 14px;
            background: #1E6FD9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: #fff;
            margin: 0 auto;
            box-shadow: 0 8px 22px rgba(30,111,217,.45);
        }

        .admin-title {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            color: #fff;
            margin-top: 14px;
        }

        .admin-card .form-label { color: #B5BFCF; font-size: 13px; font-weight: 600; }

        .admin-card .form-control {
            background: #0B1B3A;
            border: 1.5px solid rgba(255,255,255,.12);
            color: #fff;
            padding: 11px 14px;
        }

            .admin-card .form-control:focus {
                background: #0B1B3A;
                border-color: #1E6FD9;
                box-shadow: 0 0 0 3px rgba(30,111,217,.25);
                color: #fff;
            }

        .btn-admin {
            background: #1E6FD9;
            color: #fff;
            font-weight: 600;
            padding: 11px;
            border: none;
        }

            .btn-admin:hover { background: #3B8EF5; color: #fff; }

        .staff-note {
            font-size: 12px;
            color: #6B7A99;
            border-top: 1px solid rgba(255,255,255,.08);
            padding-top: 14px;
        }
    </style>
</head>
<body>
    <div class="container" style="max-width:420px;">
        <div class="admin-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="brand-badge"><i class="bi bi-shield-lock-fill"></i></div>
                <h4 class="admin-title">Yönetim Paneli</h4>
                <p style="color:#6B7A99; font-size:13.5px; margin-bottom:0;">SkyAdmin · Personel Girişi</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }

            <form asp-controller="Account" asp-action="AdminLogin" method="post">
                <div class="mb-3">
                    <label class="form-label">E-posta</label>
                    <input name="email" type="email" class="form-control" placeholder="admin@elasoft.com" required />
                </div>
                <div class="mb-4">
                    <label class="form-label">Şifre</label>
                    <input name="password" type="password" class="form-control" required />
                </div>
                <button class="btn btn-admin w-100"><i class="bi bi-box-arrow-in-right"></i> Panele Giriş Yap</button>
            </form>

            <div class="staff-note text-center mt-4">
                <i class="bi bi-info-circle"></i> Bu ekran yalnızca yetkili personel içindir.
                <div class="mt-2">
                    <a href="/" style="color:#8Fb2ff; text-decoration:none;">← Siteye dön</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
