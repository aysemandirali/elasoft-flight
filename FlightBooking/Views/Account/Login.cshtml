@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Giriş Yap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            min-height:100vh; display:flex; align-items:center;
            background:linear-gradient(135deg, rgba(15,23,42,.88), rgba(29,78,216,.72)), url('/geair/assets/img/slider/slider_bg01.jpg') center/cover no-repeat fixed;
        }
        .card { border-radius:18px; }
        .demo-box {
            background:#eff6ff; border:1px dashed #93c5fd; border-radius:12px; padding:12px 14px;
        }
        .demo-title { font-size:12px; font-weight:600; color:#1d4ed8; margin-bottom:6px; }
        .demo-row {
            display:flex; justify-content:space-between; align-items:center;
            font-size:13px; color:#475569; padding:2px 0;
        }
        .demo-row code {
            color:#0f172a; background:#dbeafe; padding:2px 8px; border-radius:6px; font-size:12.5px;
        }
    </style>
</head>
<body>
    <div class="container" style="max-width:420px;">
        <div class="card shadow-lg border-0 p-4">
            <div class="text-center mb-3">
                <i class="bi bi-airplane-engines-fill" style="font-size:40px; color:#1d4ed8;"></i>
                <h4 class="mt-2">Giriş Yap</h4>
                <p class="text-muted small mb-0">Hesabınıza giriş yapın</p>
            </div>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }
            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label">E-posta</label>
                    <input name="email" type="email" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Şifre</label>
                    <input name="password" type="password" class="form-control" required />
                </div>
                <button class="btn btn-primary w-100 py-2">Giriş Yap</button>
            </form>
            <div class="text-center mt-3">
                <span class="text-muted">Hesabın yok mu?</span>
                <a asp-controller="Account" asp-action="Register">Üye Ol</a>
            </div>

            <div class="demo-box mt-3">
                <div class="demo-title"><i class="bi bi-person-check"></i> Demo Müşteri Hesabı</div>
                <div class="demo-row"><span>E-posta</span><code>demo@elasoft.com</code></div>
                <div class="demo-row"><span>Şifre</span><code>Demo123!</code></div>
            </div>

            <div class="text-center mt-3">
                <a href="/" class="text-muted small">← Ana sayfaya dön</a>
            </div>
            <div class="text-center mt-2 pt-2 border-top">
                <a href="/Account/AdminLogin" class="text-muted small"><i class="bi bi-shield-lock"></i> Yönetici Girişi</a>
            </div>
        </div>
    </div>
</body>
</html>
