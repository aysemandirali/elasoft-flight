@model List<FlightBooking.Dtos.BookingDtos.ResultBookingDto>
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Hesabım";
    var fullName = ViewBag.FullName as string;
    var email = ViewBag.Email as string;
    ViewBag.PageTitle = "Merhaba, " + fullName;
    ViewBag.PageSubtitle = email;
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        <!-- Hızlı erişim kartları -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <a href="/Flight/Index" class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center h-100 py-3">
                        <div><i class="bi bi-search text-primary" style="font-size:26px;"></i></div>
                        <div class="fw-semibold mt-2">Uçuş Ara</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/Flight/MyBooking" class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center h-100 py-3">
                        <div><i class="bi bi-journal-bookmark text-success" style="font-size:26px;"></i></div>
                        <div class="fw-semibold mt-2">Seyahatlerim</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/Flight/CheckIn" class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center h-100 py-3">
                        <div><i class="bi bi-ticket-perforated text-secondary" style="font-size:26px;"></i></div>
                        <div class="fw-semibold mt-2">Online Check-in</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/Flight/FlightStatus" class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center h-100 py-3">
                        <div><i class="bi bi-clock-history text-info" style="font-size:26px;"></i></div>
                        <div class="fw-semibold mt-2">Uçuş Durumu</div>
                    </div>
                </a>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="m-0">Rezervasyonlarım</h4>
            <a href="/Account/Logout" class="btn btn-outline-danger btn-sm" style="background:#fff; color:#dc3545; border-color:#dc3545; padding:6px 16px;"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-journal-x text-muted" style="font-size:44px;"></i>
                    <p class="mt-3 mb-1">Bu hesaba ait rezervasyon bulunamadı.</p>
                    <p class="small text-muted">Rezervasyonlar, bilet alırken girdiğiniz e-posta (@email) ile eşleştirilir.</p>
                    <a href="/Flight/Index" class="btn btn-primary mt-2" style="background:#1d4ed8; color:#fff; padding:8px 22px;">Hemen Uçuş Ara</a>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="table-light"><tr><th>PNR</th><th>Yolcu</th><th>Tutar</th><th>Tarih</th><th>Durum</th></tr></thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td><span class="badge bg-dark">@b.PnrNumber</span></td>
                                    <td>@b.PassengerCount</td>
                                    <td>@b.TotalPrice TL</td>
                                    <td>@b.BookingDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><span class="badge bg-success">@(b.Status == "Confirmed" ? "Onaylandı" : b.Status == "Cancelled" ? "İptal Edildi" : b.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</div>
