@using FlightBooking.AgentServices
@{
    Layout = null;
    var question = ViewBag.Question as string;
    var answer = ViewBag.Answer as string;
    var intent = ViewBag.Intent as string;
    var city = ViewBag.City as string;
    var weather = ViewBag.Weather as WeatherInfo;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Seyahat Asistanı</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #0f172a; color: #e2e8f0; font-family: system-ui, sans-serif; }
        .chat-wrap { max-width: 760px; margin: 40px auto; padding: 0 16px; }
        .bubble { border-radius: 16px; padding: 14px 18px; margin-bottom: 14px; line-height: 1.6; }
        .bubble.user { background: #1d4ed8; color: #fff; margin-left: 60px; }
        .bubble.bot { background: #1e293b; color: #e2e8f0; margin-right: 60px; border: 1px solid #334155; white-space: pre-wrap; }
        .steps { background:#111827; border:1px solid #334155; border-radius:14px; padding:12px 16px; margin-bottom:14px; margin-right:60px; }
        .step { display:flex; align-items:center; gap:8px; padding:4px 0; color:#94a3b8; font-size:.9rem; }
        .step b { color:#38bdf8; }
        .title { font-weight: 700; }
    </style>
</head>
<body>
    <div class="chat-wrap">
        <h3 class="title mb-1"><i class="bi bi-robot"></i> AI Seyahat Asistanı</h3>
        <p class="text-secondary mb-4">Bir şehir söyle (örn: "Barcelona'ya gitmek istiyorum") — hava durumuna bakıp öneri yapayım.</p>

        @if (!string.IsNullOrEmpty(question))
        {
            <div class="bubble user"><i class="bi bi-person-fill"></i> @question</div>

            <div class="steps">
                <div class="step"><i class="bi bi-bullseye"></i> Niyet tespiti → <b>@(string.IsNullOrEmpty(intent) ? "—" : intent)</b></div>
                <div class="step"><i class="bi bi-search"></i> Şehir tespiti → <b>@(string.IsNullOrEmpty(city) ? "belirlenemedi" : city)</b></div>
                @if (weather != null)
                {
                    <div class="step"><i class="bi bi-cloud-sun"></i> Hava durumu aracı → <b>@weather.Temperature°C, @weather.Description</b></div>
                }
                else
                {
                    <div class="step"><i class="bi bi-cloud-slash"></i> Hava durumu aracı → <b>çağrılmadı</b></div>
                }
                <div class="step"><i class="bi bi-stars"></i> LLM ile öneri oluşturuldu</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(answer))
        {
            <div class="bubble bot"><i class="bi bi-robot"></i> @answer</div>
        }

        <form method="post" asp-controller="Agent" asp-action="Index" class="mt-3">
            <div class="input-group input-group-lg">
                <input name="message" class="form-control" placeholder="Örn: Ağustosta Barcelona'ya gitmek istiyorum" autofocus required />
                <button class="btn btn-primary" type="submit"><i class="bi bi-send-fill"></i> Sor</button>
            </div>
        </form>

        <a href="/Default/Index" class="btn btn-outline-light btn-sm mt-4">← Ana sayfaya dön</a>
    </div>
</body>
</html>
