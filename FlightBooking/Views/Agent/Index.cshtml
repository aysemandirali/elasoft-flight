@using FlightBooking.AgentServices
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "AI Seyahat Asistanı";
    ViewBag.PageTitle = "AI Seyahat Asistanı";
    ViewBag.PageSubtitle = "Bir şehir söyle, hava durumuna bakıp sana özel öneri hazırlayayım";
    var question = ViewBag.Question as string;
    var answer = ViewBag.Answer as string;
    var intent = ViewBag.Intent as string;
    var city = ViewBag.City as string;
    var weather = ViewBag.Weather as WeatherInfo;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="ai-avatar"><i class="bi bi-robot"></i></div>
                    <div>
                        <h5 class="m-0">Seyahat Asistanı</h5>
                        <span class="text-muted small">Gemini destekli · hava durumu aracı bağlı</span>
                    </div>
                </div>

                @if (string.IsNullOrEmpty(question))
                {
                    <div class="ai-intro">
                        <p class="mb-3">Merhaba! 👋 Nereye gitmek istediğini yaz, senin için hava durumuna bakıp öneride bulunayım. Örnek sorular:</p>
                        <div class="ai-chips">
                            <button type="button" class="ai-chip">Ağustosta Barcelona'ya gitmek istiyorum</button>
                            <button type="button" class="ai-chip">Roma nasıl bir yer, gitmeli miyim?</button>
                            <button type="button" class="ai-chip">Bu hafta sonu İstanbul'da hava nasıl?</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ai-msg user">
                        <div class="ai-bubble user">@question</div>
                        <div class="ai-ico user"><i class="bi bi-person-fill"></i></div>
                    </div>

                    <div class="ai-steps">
                        <div class="ai-step"><i class="bi bi-bullseye"></i> Niyet tespiti <span class="arrow">→</span> <b>@(string.IsNullOrEmpty(intent) ? "—" : intent)</b></div>
                        <div class="ai-step"><i class="bi bi-geo-alt"></i> Şehir tespiti <span class="arrow">→</span> <b>@(string.IsNullOrEmpty(city) ? "belirlenemedi" : city)</b></div>
                        @if (weather != null)
                        {
                            <div class="ai-step"><i class="bi bi-cloud-sun"></i> Hava durumu aracı <span class="arrow">→</span> <b>@weather.Temperature°C, @weather.Description</b></div>
                        }
                        else
                        {
                            <div class="ai-step"><i class="bi bi-cloud-slash"></i> Hava durumu aracı <span class="arrow">→</span> <b>çağrılmadı</b></div>
                        }
                        <div class="ai-step"><i class="bi bi-stars"></i> Yapay zeka önerisi oluşturuldu</div>
                    </div>

                    @if (!string.IsNullOrEmpty(answer))
                    {
                        <div class="ai-msg bot">
                            <div class="ai-ico bot"><i class="bi bi-robot"></i></div>
                            <div class="ai-bubble bot">@answer</div>
                        </div>
                    }
                }

                <form method="post" asp-controller="Agent" asp-action="Index" class="mt-4">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white"><i class="bi bi-chat-dots text-primary"></i></span>
                        <input name="message" id="aiInput" class="form-control" placeholder="Örn: Ağustosta Barcelona'ya gitmek istiyorum" autofocus required />
                        <button class="btn" style="background:#1d4ed8; color:#fff;" type="submit"><i class="bi bi-send-fill"></i> Sor</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .ai-avatar {
            width: 52px; height: 52px; border-radius: 14px;
            background: linear-gradient(135deg,#1d4ed8,#0ea5e9); color: #fff;
            display: flex; align-items: center; justify-content: center; font-size: 24px;
            box-shadow: 0 8px 20px rgba(29,78,216,.35);
        }
        .ai-intro { background: #f8fafc; border: 1px solid #eef2f7; border-radius: 14px; padding: 20px; }
        .ai-chips { display: flex; flex-wrap: wrap; gap: 8px; }
        .ai-chip {
            background: #fff; border: 1.5px solid #dbeafe; color: #1d4ed8; border-radius: 20px;
            padding: 7px 14px; font-size: 13.5px; cursor: pointer; transition: .15s;
        }
        .ai-chip:hover { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }

        .ai-msg { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 14px; }
        .ai-msg.user { justify-content: flex-end; }
        .ai-bubble { border-radius: 16px; padding: 13px 18px; line-height: 1.6; max-width: 80%; }
        .ai-bubble.user { background: #1d4ed8; color: #fff; border-bottom-right-radius: 4px; }
        .ai-bubble.bot { background: #f1f5f9; color: #0f172a; border-bottom-left-radius: 4px; white-space: pre-wrap; }
        .ai-ico {
            width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 16px;
        }
        .ai-ico.user { background: #1d4ed8; color: #fff; }
        .ai-ico.bot { background: #e0f2fe; color: #0284c7; }

        .ai-steps { background: #f8fafc; border: 1px solid #eef2f7; border-radius: 14px; padding: 14px 18px; margin: 4px 46px 16px 0; }
        .ai-step { display: flex; align-items: center; gap: 8px; padding: 5px 0; color: #64748b; font-size: 13.5px; }
        .ai-step i { color: #0ea5e9; }
        .ai-step b { color: #0f172a; }
        .ai-step .arrow { color: #cbd5e1; }
    </style>
    <script>
        document.querySelectorAll('.ai-chip').forEach(function (c) {
            c.addEventListener('click', function () {
                var inp = document.getElementById('aiInput');
                inp.value = this.textContent.trim();
                inp.focus();
            });
        });
    </script>
}
