@model List<FlightBooking.Entities.Car>
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Araç Kiralama";
    ViewBag.PageTitle = "Araç Kiralama";
    ViewBag.PageSubtitle = "Havalimanı ve şehir merkezlerinde uygun fiyatlı araç kiralama";
    var locations = ViewBag.Locations as List<string> ?? new List<string>();
    var selectedLoc = ViewBag.Location as string;
    var selectedCat = ViewBag.Category as string ?? "Tümü";
    var categories = new[] { "Tümü", "Ekonomi", "Konfor", "SUV", "Lüks" };
    var pickup = ViewBag.PickupDate as string;
    var dropoff = ViewBag.DropoffDate as string;
}

<div class="row justify-content-center">
    <div class="col-lg-11">

        <!-- Arama -->
        <form method="get" action="/CarRental/Index" class="card border-0 shadow-sm p-4 mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Teslim Alma Yeri</label>
                    <select name="location" class="form-select form-select-lg">
                        <option value="">Tüm şehirler</option>
                        @foreach (var l in locations)
                        {
                            <option value="@l" selected="@(l == selectedLoc)">@l</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Sınıf</label>
                    <select name="category" class="form-select form-select-lg">
                        @foreach (var c in categories)
                        {
                            <option value="@c" selected="@(c == selectedCat)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Alış</label>
                    <input type="date" name="pickupDate" value="@pickup" class="form-control form-control-lg" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">İade</label>
                    <input type="date" name="dropoffDate" value="@dropoff" class="form-control form-control-lg" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-lg w-100" style="background:#1d4ed8; color:#fff;"><i class="bi bi-search"></i> Araç Ara</button>
                </div>
            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="m-0">@Model.Count araç bulundu</h5>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Seçtiğiniz kriterlere uygun araç bulunamadı.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var car in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100 car-card">
                            <div class="car-head">
                                <span class="car-cat">@car.Category</span>
                                <i class="bi @car.Icon car-ico"></i>
                            </div>
                            <div class="card-body">
                                <h5 class="mb-1">@car.Brand @car.Model</h5>
                                <div class="text-muted small mb-3"><i class="bi bi-geo-alt"></i> @car.Location</div>
                                <div class="car-specs">
                                    <span><i class="bi bi-people"></i> @car.Seats kişi</span>
                                    <span><i class="bi bi-briefcase"></i> @car.LuggageCount bavul</span>
                                    <span><i class="bi bi-gear"></i> @car.Transmission</span>
                                    <span><i class="bi bi-fuel-pump"></i> @car.Fuel</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <div>
                                        <div class="fs-4 fw-bold text-primary">@car.DailyPrice.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ₺</div>
                                        <div class="small text-muted">/ gün</div>
                                    </div>
                                    <a href="/CarRental/Reserve?id=@car.Id&pickupDate=@pickup&dropoffDate=@dropoff" class="btn" style="background:#16a34a; color:#fff;">Seç</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

@section Scripts {
    <style>
        .car-card { transition: transform .18s, box-shadow .18s; overflow: hidden; }
        .car-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,.1) !important; }
        .car-head {
            background: linear-gradient(120deg,#1d4ed8,#0ea5e9); color:#fff;
            padding: 22px 18px; display:flex; justify-content:space-between; align-items:center;
        }
        .car-cat { font-size:12px; font-weight:600; background:rgba(255,255,255,.2); padding:3px 12px; border-radius:20px; }
        .car-ico { font-size:44px; opacity:.9; }
        .car-specs { display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:13px; color:#475569; }
        .car-specs i { color:#1d4ed8; }
    </style>
}
