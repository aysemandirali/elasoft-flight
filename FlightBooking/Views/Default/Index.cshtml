@{
    Layout = null;
}

<!doctype html>
<html class="no-js" lang="en">

    @await Component.InvokeAsync("_DefaultHeadComponentPartial")

<body>

    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")

  
    <main>

        @await Component.InvokeAsync("_DefaultSliderComponentPartial")
     
        <!-- booking-area -->
        <div class="booking-area">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        @await Component.InvokeAsync("_BookingTagsComponentPartial")
                        <div class="booking-wrap">
                            <ul class="nav nav-tabs" id="myTab" role="tablist">

                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="bOOKing-tab" data-bs-toggle="tab" data-bs-target="#bOOKing-tab-pane" type="button">
                                        <i class="flaticon-flight"></i> Uçuş Ara
                                    </button>
                                </li>

                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="trips-tab" data-bs-toggle="tab" data-bs-target="#trips-tab-pane" type="button">
                                        <i class="flaticon-file"></i> Seyahatlerim
                                    </button>
                                </li>

                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="check-tab" data-bs-toggle="tab" data-bs-target="#check-tab-pane" type="button">
                                        <i class="flaticon-tick"></i> Online Check-in
                                    </button>
                                </li>

                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="flight-tab" data-bs-toggle="tab" data-bs-target="#flight-tab-pane" type="button">
                                        <i class="flaticon-clock"></i> Uçuş Durumu
                                    </button>
                                </li>

                            </ul>


                            <div class="tab-content" id="myTabContent">

                                <!-- UÇUŞ ARAMA -->

                                <div class="tab-pane fade show active" id="bOOKing-tab-pane">

                                    <div class="tab-content-wrap">

                                        <form class="booking-form" id="flightSearchForm" method="get" action="/Flight/Index">
                                            <ul>

                                                <li>
                                                    <div class="form-grp">
                                                        <input type="text" name="from" placeholder="Nereden (örn: IST)">
                                                    </div>
                                                </li>

                                                <li>
                                                    <div class="form-grp">
                                                        <input type="text" name="to" placeholder="Nereye (örn: LHR)">
                                                        <button type="button" class="exchange-icon">
                                                            <i class="flaticon-exchange-1"></i>
                                                        </button>
                                                    </div>
                                                </li>

                                                <li>
                                                    <div class="form-grp select">
                                                        <label>Yolculuk Tipi</label>
                                                        <select class="form-select">
                                                            <option>Tek Yön</option>
                                                            <option>Gidiş - Dönüş</option>
                                                            <option>Çoklu Uçuş</option>
                                                        </select>
                                                    </div>
                                                </li>

                                                <li>
                                                    <div class="form-grp date">
                                                        <ul>
                                                            <li>
                                                                <label>Gidiş Tarihi</label>
                                                                <input type="text" class="date" placeholder="Tarih seçin">
                                                            </li>
                                                            <li>
                                                                <label>Dönüş Tarihi</label>
                                                                <input type="text" class="date" placeholder="Tarih seçin">
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </li>

                                                <li>
                                                    <div class="form-grp economy">
                                                        <label>Yolcu / Sınıf</label>
                                                        <input type="text" placeholder="1 Yolcu, Ekonomi">
                                                    </div>
                                                </li>

                                            </ul>
                                        </form>

                                        <div class="content-bottom">
                                            <a class="promo-code">+ Promosyon Kodu</a>
                                            <button type="submit" form="flightSearchForm" class="btn" style="border:none;cursor:pointer;">Uçuşları Listele <i class="flaticon-flight-1"></i></button>
                                        </div>

                                    </div>
                                </div>



                                <!-- SEYAHATLERİM -->

                                <div class="tab-pane fade" id="trips-tab-pane">

                                    <div class="tab-content-wrap">

                                        <form class="booking-form" id="myBookingForm" method="get" action="/Flight/MyBooking">
                                            <ul>

                                                <li>
                                                    <div class="form-grp">
                                                        <label>Rezervasyon Kodu (PNR)</label>
                                                        <input type="text" name="pnr" placeholder="PNR kodunu girin">
                                                    </div>
                                                </li>

                                                <li>
                                                    <div class="form-grp">
                                                        <label>Soyad</label>
                                                        <input type="text" name="surname" placeholder="Soyadınızı girin">
                                                    </div>
                                                </li>

                                            </ul>
                                        </form>

                                        <div class="content-bottom">
                                            <button type="submit" form="myBookingForm" class="btn" style="border:none;cursor:pointer;">Seyahatimi Görüntüle</button>
                                        </div>

                                    </div>
                                </div>



                                <!-- CHECK IN -->

                                <div class="tab-pane fade" id="check-tab-pane">

                                    <div class="tab-content-wrap">

                                        <form class="booking-form">
                                            <ul>

                                                <li>
                                                    <div class="form-grp">
                                                        <label>Rezervasyon Kodu</label>
                                                        <input type="text" placeholder="PNR kodu">
                                                    </div>
                                                </li>

                                                <li>
                                                    <div class="form-grp">
                                                        <label>Soyad</label>
                                                        <input type="text" placeholder="Soyad">
                                                    </div>
                                                </li>

                                            </ul>
                                        </form>

                                        <div class="content-bottom">
                                            <a class="btn">Check-in Yap</a>
                                        </div>

                                    </div>
                                </div>



                                <!-- UÇUŞ DURUMU -->

                                <div class="tab-pane fade" id="flight-tab-pane">

                                    <div class="tab-content-wrap">

                                        <form class="booking-form">
                                            <ul>

                                                <li>
                                                    <div class="form-grp">
                                                        <label>Uçuş Numarası</label>
                                                        <input type="text" placeholder="Örn: TK1234">
                                                    </div>
                                                </li>

                                                <li>
                                                    <div class="form-grp date">
                                                        <label>Tarih</label>
                                                        <input type="text" class="date" placeholder="Tarih seçin">
                                                    </div>
                                                </li>

                                            </ul>
                                        </form>

                                        <div class="content-bottom">
                                            <a class="btn">Uçuşu Sorgula</a>
                                        </div>

                                    </div>
                                </div>


                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
        <!-- booking-area-end -->
        @await Component.InvokeAsync("_DefaultFeatureSectionComponentPartial")
        @await Component.InvokeAsync("_DefaultOfferDealComponentPartial")
﻿<!-- destination-area -->
<section class="destination-area destination-bg">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">

                <div class="section-title">
                    <span class="sub-title">Özel Fırsatlar</span>
                    <h2 class="title">Hayalinizdeki Destinasyonu Keşfedin</h2>
                </div>

                <div class="destination-content">
                    <p>
                        Seyahatlerinizden kazanç sağlayın – ücretsiz
                        <span>Geairinfo.com</span> hesabı oluşturarak uçuşlarda
                        %10 veya daha fazla anında indirim fırsatını yakalayın.
                    </p>

                    <ul>

                        <li>
                            <div class="counter-item">
                                <div class="counter-content">
                                    <h2 class="count">
                                        <span class="odometer" data-count="5830"></span>+
                                    </h2>
                                    <p>Mutlu Yolcu</p>
                                </div>
                                <div class="counter-icon">
                                    <i class="flaticon-group"></i>
                                </div>
                            </div>
                        </li>

                        <li>
                            <div class="counter-item">
                                <div class="counter-content">
                                    <h2 class="count">
                                        <span class="odometer" data-count="100"></span>%
                                    </h2>
                                    <p>Müşteri Memnuniyeti</p>
                                </div>
                                <div class="counter-icon">
                                    <i class="flaticon-globe"></i>
                                </div>
                            </div>
                        </li>

                    </ul>

                    <div class="content-bottom">
                        <p>En yeni kampanyaları ve duyuruları keşfedin, seyahatinizi hemen planlayın.</p>
                        <a href="/Agent/Index">Bizimle İletişime Geçin</a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>
<!-- destination-area-end -->
