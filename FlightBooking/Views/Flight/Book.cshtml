@model FlightBooking.Dtos.FlightDtos.GetFlightByIdDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bilet Al</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style> body { background:#f1f5f9; } </style>
</head>
<body>
    <div class="container py-5" style="max-width:760px;">
        <h3 class="mb-3"><i class="bi bi-ticket-perforated"></i> Bilet Al</h3>

        <div class="alert alert-primary">
            <strong>@Model.FlightNumber</strong> — @Model.DepartureAirportCode → @Model.ArrivalAirportCode ·
            @Model.DepartureTime.ToString("dd.MM.yyyy HH:mm") ·
            <strong>@Model.BasePrice @Model.Currency</strong> / yolcu
        </div>

        <form method="post" action="/Flight/Book" class="card p-4 shadow-sm">
            <input type="hidden" name="FlightId" value="@Model.FlightId" />

            <h6 class="text-muted">İletişim Bilgileri</h6>
            <div class="row">
                <div class="col-md-4 mb-3"><label class="form-label">Ad Soyad</label><input name="ContactName" class="form-control" required /></div>
                <div class="col-md-4 mb-3"><label class="form-label">E-posta</label><input name="ContactEmail" type="email" class="form-control" required /></div>
                <div class="col-md-4 mb-3"><label class="form-label">Telefon</label><input name="ContactPhone" class="form-control" required /></div>
            </div>

            <hr />
            <h6 class="text-muted">Yolcu Bilgileri</h6>
            <div class="row">
                <div class="col-md-3 mb-3"><label class="form-label">Ad</label><input name="Passengers[0].Name" class="form-control" required /></div>
                <div class="col-md-3 mb-3"><label class="form-label">Soyad</label><input name="Passengers[0].Surname" class="form-control" required /></div>
                <div class="col-md-2 mb-3"><label class="form-label">Doğum T.</label><input name="Passengers[0].BirthDate" type="date" class="form-control" required /></div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Cinsiyet</label>
                    <select name="Passengers[0].Gender" class="form-select"><option>Erkek</option><option>Kadın</option></select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Tip</label>
                    <select name="Passengers[0].PassengerType" class="form-select"><option>Yetişkin</option><option>Çocuk</option><option>Bebek</option></select>
                </div>
            </div>

            <div class="mt-2">
                <button class="btn btn-success btn-lg"><i class="bi bi-check-circle"></i> Rezervasyonu Tamamla</button>
                <a href="/Flight/Index" class="btn btn-outline-secondary btn-lg">Vazgeç</a>
            </div>
        </form>
    </div>
</body>
</html>
