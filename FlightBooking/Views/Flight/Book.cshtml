@model FlightBooking.Dtos.FlightDtos.GetFlightByIdDto
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Bilet Al";
    ViewBag.PageTitle = "Bilet Al";
    ViewBag.PageSubtitle = $"{Model.FlightNumber} · {Model.DepartureAirportCode} → {Model.ArrivalAirportCode}";
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center" style="gap:12px;">
                <div class="d-flex align-items-center gap-3">
                    <div class="text-center">
                        <div class="fw-bold fs-4">@Model.DepartureAirportCode</div>
                        <div class="small text-muted">@Model.DepartureTime.ToString("dd.MM HH:mm")</div>
                    </div>
                    <i class="bi bi-airplane-fill text-primary fs-4"></i>
                    <div class="text-center">
                        <div class="fw-bold fs-4">@Model.ArrivalAirportCode</div>
                        <div class="small text-muted">@Model.ArrivalTime.ToString("dd.MM HH:mm")</div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="small text-muted">@Model.FlightNumber</div>
                    <div class="fs-5 fw-bold text-primary">@Model.BasePrice.ToString("#,##0", tr) @Model.Currency <span class="small text-muted fw-normal">/ yolcu</span></div>
                </div>
            </div>
        </div>

        <form method="post" action="/Flight/Book" class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <input type="hidden" name="FlightId" value="@Model.FlightId" />

                <h6 class="text-muted mb-3"><i class="bi bi-person-lines-fill"></i> İletişim Bilgileri</h6>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Ad Soyad</label><input name="ContactName" class="form-control" required /></div>
                    <div class="col-md-4"><label class="form-label">E-posta</label><input name="ContactEmail" type="email" class="form-control" required /></div>
                    <div class="col-md-4"><label class="form-label">Telefon</label><input name="ContactPhone" class="form-control" required /></div>
                </div>

                <hr class="my-4" />
                <h6 class="text-muted mb-3"><i class="bi bi-person-badge"></i> Yolcu Bilgileri</h6>
                <div class="row g-3">
                    <div class="col-md-3"><label class="form-label">Ad</label><input name="Passengers[0].Name" class="form-control" required /></div>
                    <div class="col-md-3"><label class="form-label">Soyad</label><input name="Passengers[0].Surname" class="form-control" required /></div>
                    <div class="col-md-2"><label class="form-label">Doğum T.</label><input name="Passengers[0].BirthDate" type="date" class="form-control" required /></div>
                    <div class="col-md-2">
                        <label class="form-label">Cinsiyet</label>
                        <select name="Passengers[0].Gender" class="form-select"><option>Erkek</option><option>Kadın</option></select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Tip</label>
                        <select name="Passengers[0].PassengerType" class="form-select"><option>Yetişkin</option><option>Çocuk</option><option>Bebek</option></select>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a href="/Flight/Index" class="btn btn-outline-secondary">Vazgeç</a>
                    <button class="btn btn-lg" style="background:#16a34a; color:#fff;"><i class="bi bi-arrow-right-circle"></i> Ödemeye Geç</button>
                </div>
            </div>
        </form>

    </div>
</div>
