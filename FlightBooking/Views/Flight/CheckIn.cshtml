@model FlightBooking.Entities.Booking
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Online Check-in";
    ViewBag.PageTitle = "Online Check-in";
    ViewBag.PageSubtitle = "PNR ve soyadınızla check-in yapın, koltuk ve ek hizmetlerinizi seçin";
    var searched = (bool)(ViewBag.Searched ?? false);
    var pnr = ViewBag.Pnr as string;
    var surname = ViewBag.Surname as string;
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        @if (TempData["CheckInOk"] != null)
        {
            <div class="alert alert-success"><i class="bi bi-check-circle"></i> @TempData["CheckInOk"]</div>
        }
        @if (TempData["CheckInError"] != null)
        {
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @TempData["CheckInError"]</div>
        }

        <form method="get" action="/Flight/CheckIn" class="card border-0 shadow-sm p-4 mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Rezervasyon Kodu (PNR)</label>
                    <input name="pnr" value="@pnr" class="form-control form-control-lg" placeholder="Örn: A1B2C3" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Soyad</label>
                    <input name="surname" value="@surname" class="form-control form-control-lg" placeholder="Soyadınız" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-lg w-100" style="background:#1d4ed8; color:#fff;"><i class="bi bi-search"></i> Sorgula</button>
                </div>
            </div>
        </form>

        @if (searched && Model == null)
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Bu bilgilerle bir rezervasyon bulunamadı.</div>
        }

        @if (Model != null)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h6 class="text-muted">Rezervasyon <span class="badge bg-dark">@Model.PnrNumber</span></h6>
                    <div class="table-responsive">
                    <table class="table align-middle mt-2">
                        <thead class="table-light"><tr><th>Yolcu</th><th>Durum</th><th>Koltuk</th><th>Biniş Kartı</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Passengers)
                            {
                                <tr>
                                    <td>@p.Name @p.Surname</td>
                                    <td>
                                        @if (p.IsCheckedIn) { <span class="badge bg-success">Check-in yapıldı</span> }
                                        else { <span class="badge bg-warning text-dark">Bekliyor</span> }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(p.SeatNumber) ? "—" : p.SeatNumber)</td>
                                    <td>@(string.IsNullOrEmpty(p.BoardingPassNumber) ? "—" : p.BoardingPassNumber)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>

            @for (int i = 0; i < Model.Passengers.Count; i++)
            {
                var p = Model.Passengers[i];
                if (!p.IsCheckedIn)
                {
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white"><strong><i class="bi bi-person-check"></i> @p.Name @p.Surname</strong> için check-in</div>
                        <div class="card-body">
                            <form method="post" action="/Flight/CheckInComplete" class="checkin-form">
                                <input type="hidden" name="pnr" value="@Model.PnrNumber" />
                                <input type="hidden" name="passengerIndex" value="@i" />
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Koltuk</label>
                                        <input type="hidden" name="seatNumber" class="seat-input" required />
                                        <button type="button" class="btn btn-outline-primary w-100 seat-open">
                                            <i class="bi bi-grid-3x3-gap"></i> <span class="seat-label">Koltuk Seç</span>
                                        </button>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Ek Bagaj</label>
                                        <select name="extraBaggageKg" class="form-select js-extra">
                                            <option value="0" data-price="0">Yok</option>
                                            <option value="10" data-price="150">+10 kg (150 ₺)</option>
                                            <option value="20" data-price="300">+20 kg (300 ₺)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Yemek</label>
                                        <select name="mealType" class="form-select js-extra">
                                            <option value="Yok" data-price="0">Yok</option>
                                            <option value="Standart" data-price="50">Standart (50 ₺)</option>
                                            <option value="Vejetaryen" data-price="80">Vejetaryen (80 ₺)</option>
                                            <option value="Premium Menü" data-price="150">Premium Menü (150 ₺)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Koltuk Yükseltme</label>
                                        <div class="form-check mt-2">
                                            <input type="hidden" name="seatUpgrade" value="false" />
                                            <input type="checkbox" name="seatUpgrade" value="true" class="form-check-input js-extra" data-price="100" />
                                            <label class="form-check-label">Ön Sıra (+100 ₺)</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div>Ek Hizmet Toplamı: <strong class="js-total text-primary">0 ₺</strong></div>
                                    <button class="btn" style="background:#16a34a; color:#fff;"><i class="bi bi-check-circle"></i> Check-in'i Tamamla</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
        }

    </div>
</div>

@{
    var occupiedSeats = ViewBag.OccupiedSeats as List<string> ?? new List<string>();
}

<!-- Koltuk haritası modalı -->
<div id="seatModal" class="seat-modal">
    <div class="seat-modal-box">
        <div class="seat-modal-head">
            <div>
                <strong>Koltuk Seçimi</strong>
                <div class="small text-muted">Uçağın gidiş yönüne göre yerleşim</div>
            </div>
            <button type="button" class="btn-close" onclick="closeSeatModal()"></button>
        </div>

        <div class="seat-legend">
            <span><i class="seat-dot free"></i> Boş</span>
            <span><i class="seat-dot taken"></i> Dolu</span>
            <span><i class="seat-dot sel"></i> Seçili</span>
        </div>

        <div class="seat-cabin">
            <div class="seat-cockpit"><i class="bi bi-airplane"></i> Ön</div>
            <div id="seatGrid" class="seat-grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function hesapla(form) {
            let t = 0;
            form.querySelectorAll('.js-extra').forEach(function (el) {
                if (el.type === 'checkbox') { if (el.checked) t += 100; }
                else { var o = el.options[el.selectedIndex]; t += parseInt(o.dataset.price || '0'); }
            });
            form.querySelector('.js-total').textContent = t + ' ₺';
        }
        document.querySelectorAll('.checkin-form').forEach(function (f) {
            f.querySelectorAll('.js-extra').forEach(function (el) { el.addEventListener('change', function () { hesapla(f); }); });
        });

        // ---- Görsel koltuk haritası ----
        var occupied = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(occupiedSeats));
        var takenSet = new Set(occupied);          // uçuştaki dolu koltuklar
        var chosen = {};                            // bu oturumda seçilenler {seat: formEl}
        var activeForm = null;
        var rows = 30, cols = ['A', 'B', 'C', 'D', 'E', 'F'];

        function buildGrid() {
            var g = document.getElementById('seatGrid');
            g.innerHTML = '';
            for (var r = 1; r <= rows; r++) {
                var rowEl = document.createElement('div');
                rowEl.className = 'seat-row';
                var num = document.createElement('span');
                num.className = 'seat-rownum';
                num.textContent = r;
                rowEl.appendChild(num);
                cols.forEach(function (c, idx) {
                    if (idx === 3) {
                        var aisle = document.createElement('span');
                        aisle.className = 'seat-aisle';
                        rowEl.appendChild(aisle);
                    }
                    var seat = r + c;
                    var s = document.createElement('button');
                    s.type = 'button';
                    s.className = 'seat';
                    s.textContent = c;
                    s.dataset.seat = seat;
                    if (takenSet.has(seat) && !(chosen[seat])) { s.classList.add('taken'); s.disabled = true; }
                    s.addEventListener('click', function () { pickSeat(this.dataset.seat); });
                    rowEl.appendChild(s);
                });
                g.appendChild(rowEl);
            }
        }

        function refreshGrid() {
            document.querySelectorAll('#seatGrid .seat').forEach(function (s) {
                var seat = s.dataset.seat;
                s.classList.remove('sel');
                var mineHere = activeForm && activeForm.querySelector('.seat-input').value === seat;
                if (mineHere) s.classList.add('sel');
            });
        }

        function openSeatModal(form) {
            activeForm = form;
            buildGrid();
            refreshGrid();
            document.getElementById('seatModal').classList.add('open');
        }
        function closeSeatModal() {
            document.getElementById('seatModal').classList.remove('open');
        }

        function pickSeat(seat) {
            if (takenSet.has(seat)) return;
            // önceki seçimi serbest bırak
            var prev = activeForm.querySelector('.seat-input').value;
            if (prev) { takenSet.delete(prev); delete chosen[prev]; }
            // yeni seçimi işaretle
            activeForm.querySelector('.seat-input').value = seat;
            activeForm.querySelector('.seat-label').textContent = 'Koltuk ' + seat;
            takenSet.add(seat);
            chosen[seat] = activeForm;
            closeSeatModal();
        }

        document.querySelectorAll('.seat-open').forEach(function (btn) {
            btn.addEventListener('click', function () { openSeatModal(this.closest('form')); });
        });
        document.getElementById('seatModal').addEventListener('click', function (e) {
            if (e.target === this) closeSeatModal();
        });
    </script>
    <style>
        .seat-modal {
            position: fixed; inset: 0; background: rgba(15,23,42,.6); z-index: 1050;
            display: none; align-items: center; justify-content: center; padding: 16px;
        }
        .seat-modal.open { display: flex; }
        .seat-modal-box {
            background: #fff; border-radius: 16px; width: 100%; max-width: 440px;
            max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.35);
        }
        .seat-modal-head { display: flex; justify-content: space-between; align-items: center; padding: 18px 20px; border-bottom: 1px solid #eef2f7; }
        .seat-legend { display: flex; gap: 16px; justify-content: center; padding: 12px; font-size: 12.5px; color: #475569; }
        .seat-dot { display: inline-block; width: 14px; height: 14px; border-radius: 4px; vertical-align: middle; margin-right: 4px; }
        .seat-dot.free { background: #fff; border: 1.5px solid #cbd5e1; }
        .seat-dot.taken { background: #cbd5e1; }
        .seat-dot.sel { background: #16a34a; }
        .seat-cabin { padding: 0 18px 22px; }
        .seat-cockpit { text-align: center; color: #64748b; font-size: 13px; padding: 8px; border-bottom: 2px dashed #e2e8f0; margin-bottom: 14px; }
        .seat-grid { display: flex; flex-direction: column; gap: 6px; }
        .seat-row { display: flex; align-items: center; gap: 6px; justify-content: center; }
        .seat-rownum { width: 22px; text-align: center; font-size: 11px; color: #94a3b8; }
        .seat-aisle { width: 18px; }
        .seat {
            width: 34px; height: 34px; border-radius: 8px; border: 1.5px solid #cbd5e1;
            background: #fff; color: #334155; font-size: 12px; font-weight: 600; cursor: pointer;
            transition: all .12s;
        }
        .seat:hover:not(.taken) { border-color: #1d4ed8; background: #eff6ff; }
        .seat.taken { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; border-color: #e2e8f0; }
        .seat.sel { background: #16a34a; color: #fff; border-color: #16a34a; }
    </style>
}
