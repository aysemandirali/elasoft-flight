@{
    Layout = null;
    var pnr = ViewBag.Pnr as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rezervasyon Onayı</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style> body { background:#f1f5f9; } </style>
</head>
<body>
    <div class="container py-5 text-center" style="max-width:560px;">
        <div class="card shadow-sm p-5">
            <i class="bi bi-check-circle-fill text-success" style="font-size:64px;"></i>
            <h3 class="mt-3">Rezervasyonun Tamamlandı!</h3>
            <p class="text-muted">Aşağıdaki PNR kodunu online check-in için saklayın.</p>
            <div class="my-3">
                <span class="badge bg-dark" style="font-size:1.6rem; letter-spacing:3px;">@pnr</span>
            </div>
            <div class="d-grid gap-2">
                <a href="/Flight/Index" class="btn btn-primary">Yeni Uçuş Ara</a>
                <a href="/Admin/CheckIn/Index" class="btn btn-outline-secondary">Online Check-in'e Git</a>
            </div>
        </div>
    </div>
</body>
</html>
