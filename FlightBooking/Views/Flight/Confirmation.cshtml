@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Rezervasyon Onayı";
    ViewBag.PageTitle = "Rezervasyon Onayı";
    ViewBag.PageSubtitle = "Uçuş rezervasyonunuz tamamlandı";
    var pnr = ViewBag.Pnr as string;
    var paid = (bool)(ViewBag.Paid ?? false);
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm text-center p-5">
            <div><i class="bi bi-check-circle-fill text-success" style="font-size:64px;"></i></div>
            <h3 class="mt-3">Rezervasyonun Tamamlandı!</h3>
            <p class="text-muted">Aşağıdaki PNR kodunu online check-in için saklayın.</p>

            <div class="my-3">
                <span class="badge bg-dark" style="font-size:1.6rem; letter-spacing:3px;">@pnr</span>
            </div>

            @if (paid)
            {
                <div class="mx-auto mb-3" style="max-width:320px;">
                    <span class="badge bg-success fs-6 py-2 px-3"><i class="bi bi-shield-check"></i> Ödeme Alındı</span>
                </div>
            }
            else
            {
                <div class="mx-auto mb-3" style="max-width:360px;">
                    <span class="badge bg-warning text-dark fs-6 py-2 px-3"><i class="bi bi-exclamation-triangle"></i> Ödeme Bekliyor</span>
                    <div class="mt-2"><a href="/Flight/Payment?pnr=@pnr" class="btn btn-sm" style="background:#16a34a; color:#fff;">Şimdi Öde</a></div>
                </div>
            }

            <div class="d-grid gap-2 mt-2 mx-auto" style="max-width:420px;">
                <a href="/Flight/MyBooking?pnr=@pnr" class="btn btn-primary" style="background:#1d4ed8;">Rezervasyonumu Gör</a>
                <a href="/Flight/CheckIn?pnr=@pnr" class="btn btn-outline-secondary">Online Check-in'e Git</a>
                <a href="/Flight/Index" class="btn btn-link">Yeni Uçuş Ara</a>
            </div>
        </div>
    </div>
</div>
