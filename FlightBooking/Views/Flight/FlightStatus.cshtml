@model List<FlightBooking.Dtos.FlightDtos.ResultFlightDto>
@{
    Layout = null;
    var searched = (bool)(ViewBag.Searched ?? false);
    var flightNumber = ViewBag.FlightNumber as string;

    string StatusText(string s) => s switch
    {
        "Scheduled" => "Planlandı",
        "Delayed" => "Gecikmeli",
        "Cancelled" => "İptal Edildi",
        "Completed" => "Tamamlandı",
        _ => s
    };
    string StatusBadge(string s) => s switch
    {
        "Delayed" => "bg-warning text-dark",
        "Cancelled" => "bg-danger",
        "Completed" => "bg-secondary",
        _ => "bg-success"
    };
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Uçuş Durumu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style> body { background:#f1f5f9; } .hero { background:linear-gradient(120deg,#1d4ed8,#0ea5e9); color:#fff; padding:48px 0; } </style>
</head>
<body>
    <div class="hero">
        <div class="container">
            <h2 class="mb-1"><i class="bi bi-clock-history"></i> Uçuş Durumu</h2>
            <p class="mb-0 opacity-75">Uçuş numaranızı girerek anlık uçuş durumunu öğrenin.</p>
        </div>
    </div>

    <div class="container py-4" style="max-width:960px;">
        <form method="get" action="/Flight/FlightStatus" class="card shadow-sm p-4 mb-4 border-0">
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Uçuş Numarası</label>
                    <input name="flightNumber" value="@flightNumber" class="form-control form-control-lg" placeholder="Örn: TK1932" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary btn-lg w-100"><i class="bi bi-search"></i> Sorgula</button>
                </div>
            </div>
        </form>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Uçuş bulunamadı. Uçuş numarasını kontrol edin.</div>
        }
        else
        {
            @if (!searched)
            {
                <p class="text-muted">Yaklaşan uçuşlar:</p>
            }
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="table-light">
                            <tr><th>Uçuş</th><th>Rota</th><th>Kalkış</th><th>Varış</th><th>Durum</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model)
                            {
                                <tr>
                                    <td><strong>@f.FlightNumber</strong><div class="small text-muted">@f.AirlineCode</div></td>
                                    <td>@f.DepartureAirportCode <i class="bi bi-arrow-right text-primary"></i> @f.ArrivalAirportCode</td>
                                    <td>@f.DepartureTime.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@f.ArrivalTime.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><span class="badge @StatusBadge(f.Status) fs-6">@StatusText(f.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <a href="/" class="btn btn-outline-secondary mt-4">← Ana sayfa</a>
    </div>
</body>
</html>
