@model FlightBooking.Entities.Booking
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Seyahatlerim";
    ViewBag.PageTitle = "Seyahatlerim";
    ViewBag.PageSubtitle = "PNR ve soyadınızla rezervasyonunuzu görüntüleyin";
    var searched = (bool)(ViewBag.Searched ?? false);
    var pnr = ViewBag.Pnr as string;
    var surname = ViewBag.Surname as string;
    var flight = ViewBag.Flight as FlightBooking.Dtos.FlightDtos.GetFlightByIdDto;
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <form method="get" action="/Flight/MyBooking" class="card border-0 shadow-sm p-4 mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Rezervasyon Kodu (PNR)</label>
                    <input name="pnr" value="@pnr" class="form-control form-control-lg" placeholder="Örn: A1B2C3" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Soyad</label>
                    <input name="surname" value="@surname" class="form-control form-control-lg" placeholder="Soyadınız" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-lg w-100" style="background:#1d4ed8; color:#fff;"><i class="bi bi-search"></i> Sorgula</button>
                </div>
            </div>
        </form>

        @if (searched && Model == null)
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Bu bilgilerle bir rezervasyon bulunamadı.</div>
        }

        @if (Model != null)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="m-0">Rezervasyon <span class="badge bg-dark ms-1" style="letter-spacing:2px;">@Model.PnrNumber</span></h5>
                        <div class="d-flex gap-2">
                            <span class="badge bg-success fs-6">@(Model.Status == "Confirmed" ? "Onaylandı" : Model.Status == "Cancelled" ? "İptal Edildi" : Model.Status)</span>
                            @if (Model.PaymentStatus == "Ödendi")
                            {
                                <span class="badge fs-6" style="background:#0f766e;"><i class="bi bi-shield-check"></i> Ödendi</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-clock"></i> Ödeme Bekliyor</span>
                            }
                        </div>
                    </div>

                    @if (flight != null)
                    {
                        <div class="d-flex align-items-center gap-3 p-3 mb-3 rounded" style="background:#eff6ff;">
                            <div class="text-center">
                                <div class="fw-bold fs-4">@flight.DepartureAirportCode</div>
                                <div class="small text-muted">@flight.DepartureAirportName</div>
                            </div>
                            <div class="flex-grow-1 text-center text-primary"><i class="bi bi-airplane-fill"></i> ——</div>
                            <div class="text-center">
                                <div class="fw-bold fs-4">@flight.ArrivalAirportCode</div>
                                <div class="small text-muted">@flight.ArrivalAirportName</div>
                            </div>
                            <div class="text-end ms-3">
                                <div class="small text-muted">Kalkış</div>
                                <div class="fw-semibold">@flight.DepartureTime.ToString("dd.MM.yyyy HH:mm")</div>
                                <div class="small">@flight.FlightNumber</div>
                            </div>
                        </div>
                    }

                    <div class="row text-muted small mb-3">
                        <div class="col-md-4"><i class="bi bi-person"></i> @Model.ContactName</div>
                        <div class="col-md-4"><i class="bi bi-envelope"></i> @Model.ContactEmail</div>
                        <div class="col-md-4"><i class="bi bi-telephone"></i> @Model.ContactPhone</div>
                    </div>

                    <h6 class="text-muted">Yolcular</h6>
                    <table class="table align-middle">
                        <thead class="table-light"><tr><th>Ad Soyad</th><th>Tip</th><th>Koltuk</th><th>Durum</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Passengers)
                            {
                                <tr>
                                    <td>@p.Name @p.Surname</td>
                                    <td>@p.PassengerType</td>
                                    <td>@(string.IsNullOrEmpty(p.SeatNumber) ? "—" : p.SeatNumber)</td>
                                    <td>
                                        @if (p.IsCheckedIn) { <span class="badge bg-success">Check-in yapıldı</span> }
                                        else { <span class="badge bg-warning text-dark">Bekliyor</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                        <div class="fs-5">Toplam: <strong class="text-primary">@Html.Money(Model.TotalPrice)</strong></div>
                        @if (Model.Status == "Cancelled")
                        {
                            <span class="badge bg-danger fs-6 py-2 px-3"><i class="bi bi-x-circle"></i> Bu rezervasyon iptal edildi</span>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                @if (Model.PaymentStatus != "Ödendi")
                                {
                                    <a href="/Flight/Payment?pnr=@Model.PnrNumber" class="btn" style="background:#1d4ed8; color:#fff;"><i class="bi bi-credit-card"></i> Şimdi Öde</a>
                                }
                                <a href="/Flight/CheckIn?pnr=@Model.PnrNumber" class="btn" style="background:#16a34a; color:#fff;"><i class="bi bi-ticket-perforated"></i> Online Check-in</a>
                                <form method="post" action="/Flight/CancelBooking" onsubmit="return confirm('Rezervasyonunuzu iptal etmek istediğinize emin misiniz? Bu işlem geri alınamaz.');" class="d-inline">
                                    <input type="hidden" name="pnr" value="@Model.PnrNumber" />
                                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> İptal Et</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

    </div>
</div>
