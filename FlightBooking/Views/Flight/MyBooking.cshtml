@model FlightBooking.Entities.Booking
@{
    Layout = null;
    var searched = (bool)(ViewBag.Searched ?? false);
    var pnr = ViewBag.Pnr as string;
    var surname = ViewBag.Surname as string;
    var flight = ViewBag.Flight as FlightBooking.Dtos.FlightDtos.GetFlightByIdDto;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Seyahatlerim</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background:#f1f5f9; }
        .hero { background:linear-gradient(120deg,#1d4ed8,#0ea5e9); color:#fff; padding:48px 0; }
    </style>
</head>
<body>
    <div class="hero">
        <div class="container">
            <h2 class="mb-1"><i class="bi bi-journal-bookmark"></i> Seyahatlerim</h2>
            <p class="mb-0 opacity-75">Rezervasyon kodunuz (PNR) ve soyadınız ile seyahatinizi görüntüleyin.</p>
        </div>
    </div>

    <div class="container py-4" style="max-width:820px;">
        <!-- Sorgu formu -->
        <form method="get" action="/Flight/MyBooking" class="card shadow-sm p-4 mb-4 border-0">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Rezervasyon Kodu (PNR)</label>
                    <input name="pnr" value="@pnr" class="form-control form-control-lg" placeholder="Örn: A1B2C3" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Soyad</label>
                    <input name="surname" value="@surname" class="form-control form-control-lg" placeholder="Soyadınız" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary btn-lg w-100"><i class="bi bi-search"></i> Sorgula</button>
                </div>
            </div>
        </form>

        @if (searched && Model == null)
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Bu bilgilerle bir rezervasyon bulunamadı. PNR ve soyadı kontrol edin.</div>
        }

        @if (Model != null)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="m-0">Rezervasyon <span class="badge bg-dark ms-1" style="letter-spacing:2px;">@Model.PnrNumber</span></h5>
                        <span class="badge bg-success fs-6">@Model.Status</span>
                    </div>

                    @if (flight != null)
                    {
                        <div class="d-flex align-items-center gap-3 p-3 mb-3 rounded" style="background:#eff6ff;">
                            <div class="text-center">
                                <div class="fw-bold fs-4">@flight.DepartureAirportCode</div>
                                <div class="small text-muted">@flight.DepartureAirportName</div>
                            </div>
                            <div class="flex-grow-1 text-center text-primary"><i class="bi bi-airplane-fill"></i> ——</div>
                            <div class="text-center">
                                <div class="fw-bold fs-4">@flight.ArrivalAirportCode</div>
                                <div class="small text-muted">@flight.ArrivalAirportName</div>
                            </div>
                            <div class="text-end ms-3">
                                <div class="small text-muted">Kalkış</div>
                                <div class="fw-semibold">@flight.DepartureTime.ToString("dd.MM.yyyy HH:mm")</div>
                                <div class="small">@flight.FlightNumber</div>
                            </div>
                        </div>
                    }

                    <div class="row text-muted small mb-3">
                        <div class="col-md-4"><i class="bi bi-person"></i> @Model.ContactName</div>
                        <div class="col-md-4"><i class="bi bi-envelope"></i> @Model.ContactEmail</div>
                        <div class="col-md-4"><i class="bi bi-telephone"></i> @Model.ContactPhone</div>
                    </div>

                    <h6 class="text-muted">Yolcular</h6>
                    <table class="table align-middle">
                        <thead class="table-light"><tr><th>Ad Soyad</th><th>Tip</th><th>Koltuk</th><th>Durum</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Passengers)
                            {
                                <tr>
                                    <td>@p.Name @p.Surname</td>
                                    <td>@p.PassengerType</td>
                                    <td>@(string.IsNullOrEmpty(p.SeatNumber) ? "—" : p.SeatNumber)</td>
                                    <td>
                                        @if (p.IsCheckedIn)
                                        {
                                            <span class="badge bg-success">Check-in yapıldı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Bekliyor</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div class="fs-5">Toplam: <strong class="text-primary">@Model.TotalPrice TL</strong></div>
                        <a href="/Flight/CheckIn?pnr=@Model.PnrNumber" class="btn btn-success"><i class="bi bi-ticket-perforated"></i> Online Check-in</a>
                    </div>
                </div>
            </div>
        }

        <a href="/" class="btn btn-outline-secondary">← Ana sayfa</a>
    </div>
</body>
</html>
