@model FlightBooking.Entities.Booking
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Ödeme";
    ViewBag.PageTitle = "Ödeme";
    ViewBag.PageSubtitle = "Rezervasyonunuzu tamamlamak için ödeme yapın";
    var flight = ViewBag.Flight as FlightBooking.Dtos.FlightDtos.GetFlightByIdDto;
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="row g-4">

            <!-- Ödeme özeti -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="mb-3">Rezervasyon Özeti</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">PNR</span>
                            <span class="badge bg-dark" style="letter-spacing:2px;">@Model.PnrNumber</span>
                        </div>
                        @if (flight != null)
                        {
                            <div class="p-3 rounded mb-3" style="background:#eff6ff;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="text-center">
                                        <div class="fw-bold fs-5">@flight.DepartureAirportCode</div>
                                        <div class="small text-muted">@flight.DepartureTime.ToString("dd.MM HH:mm")</div>
                                    </div>
                                    <i class="bi bi-airplane-fill text-primary"></i>
                                    <div class="text-center">
                                        <div class="fw-bold fs-5">@flight.ArrivalAirportCode</div>
                                        <div class="small text-muted">@flight.ArrivalTime.ToString("dd.MM HH:mm")</div>
                                    </div>
                                </div>
                                <div class="text-center small text-muted mt-1">@flight.FlightNumber</div>
                            </div>
                        }
                        <ul class="list-unstyled m-0">
                            <li class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Yolcu</span><strong>@Model.Passengers.Count kişi</strong></li>
                            <li class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">İletişim</span><strong>@Model.ContactName</strong></li>
                            <li class="d-flex justify-content-between py-2"><span class="text-muted">Ödenecek</span><strong class="text-primary fs-4">@Model.TotalPrice.ToString("#,##0", tr) ₺</strong></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Kart formu -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <!-- Kart önizleme -->
                        <div class="pay-card mb-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <i class="bi bi-cpu" style="font-size:26px;"></i>
                                <i class="bi bi-credit-card-2-front" style="font-size:24px;"></i>
                            </div>
                            <div class="pay-num" id="prevNum">•••• •••• •••• ••••</div>
                            <div class="d-flex justify-content-between">
                                <div><div class="pay-lbl">Kart Sahibi</div><div id="prevName">AD SOYAD</div></div>
                                <div><div class="pay-lbl">SKT</div><div id="prevExp">AA/YY</div></div>
                            </div>
                        </div>

                        <form method="post" action="/Flight/PaymentComplete" id="payForm">
                            <input type="hidden" name="pnr" value="@Model.PnrNumber" />
                            <div class="mb-3">
                                <label class="form-label">Kart Numarası</label>
                                <input id="cardNum" inputmode="numeric" maxlength="19" class="form-control form-control-lg" placeholder="0000 0000 0000 0000" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Kart Üzerindeki İsim</label>
                                <input id="cardName" class="form-control form-control-lg" placeholder="Ad Soyad" required />
                            </div>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label">Son Kullanma (AA/YY)</label>
                                    <input id="cardExp" maxlength="5" class="form-control form-control-lg" placeholder="12/28" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">CVV</label>
                                    <input id="cardCvv" inputmode="numeric" maxlength="3" class="form-control form-control-lg" placeholder="123" required />
                                </div>
                            </div>

                            <button class="btn btn-lg w-100 mt-4" style="background:#16a34a; color:#fff;">
                                <i class="bi bi-lock-fill"></i> @Model.TotalPrice.ToString("#,##0", tr) ₺ Öde
                            </button>
                            <div class="text-center small text-muted mt-2"><i class="bi bi-shield-check"></i> Bu bir demo ödeme ekranıdır, gerçek tahsilat yapılmaz.</div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <style>
        .pay-card {
            background: linear-gradient(135deg,#1d4ed8,#0ea5e9); color:#fff;
            border-radius:16px; padding:22px 24px; box-shadow:0 10px 30px rgba(29,78,216,.35);
        }
        .pay-num { font-size:22px; letter-spacing:3px; margin:22px 0 18px; font-family:monospace; }
        .pay-lbl { font-size:10px; opacity:.7; text-transform:uppercase; letter-spacing:1px; }
    </style>
    <script>
        var num = document.getElementById('cardNum');
        var name = document.getElementById('cardName');
        var exp = document.getElementById('cardExp');
        var cvv = document.getElementById('cardCvv');

        num.addEventListener('input', function () {
            var v = this.value.replace(/\D/g, '').slice(0, 16);
            this.value = v.replace(/(.{4})/g, '$1 ').trim();
            document.getElementById('prevNum').textContent = this.value || '•••• •••• •••• ••••';
        });
        name.addEventListener('input', function () {
            document.getElementById('prevName').textContent = (this.value || 'AD SOYAD').toUpperCase();
        });
        exp.addEventListener('input', function () {
            var v = this.value.replace(/\D/g, '').slice(0, 4);
            if (v.length >= 3) v = v.slice(0, 2) + '/' + v.slice(2);
            this.value = v;
            document.getElementById('prevExp').textContent = this.value || 'AA/YY';
        });
        cvv.addEventListener('input', function () { this.value = this.value.replace(/\D/g, ''); });

        // Basit doğrulama: 16 hane kart + 3 hane cvv
        document.getElementById('payForm').addEventListener('submit', function (e) {
            var digits = num.value.replace(/\s/g, '');
            if (digits.length !== 16) { e.preventDefault(); alert('Kart numarası 16 haneli olmalı.'); return; }
            if (cvv.value.length !== 3) { e.preventDefault(); alert('CVV 3 haneli olmalı.'); return; }
        });
    </script>
}
