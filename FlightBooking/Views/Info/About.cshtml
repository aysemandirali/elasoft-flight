@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Hakkımızda";
    ViewBag.PageTitle = "Hakkımızda";
    ViewBag.PageSubtitle = "Geair — dünyayı keşfetmenin en kolay yolu";
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-5">
                <h4 class="mb-3">Biz Kimiz?</h4>
                <p class="text-secondary">Geair, yüzlerce havayolunu tek bir çatı altında toplayan; uçuş, araç kiralama, tur ve havalimanı transferi hizmetlerini kolayca karşılaştırıp rezerve etmenizi sağlayan bir seyahat platformudur. Amacımız, seyahat planlamayı herkes için basit, hızlı ve güvenilir hale getirmek.</p>
                <p class="text-secondary mb-0">Gelişmiş arama altyapımız ve yapay zeka destekli seyahat asistanımızla, size en uygun seçenekleri saniyeler içinde sunuyoruz.</p>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm text-center h-100 py-4">
                    <div class="fs-2 fw-bold text-primary">500+</div>
                    <div class="text-muted small">Havayolu</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm text-center h-100 py-4">
                    <div class="fs-2 fw-bold text-primary">120+</div>
                    <div class="text-muted small">Ülke</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm text-center h-100 py-4">
                    <div class="fs-2 fw-bold text-primary">2M+</div>
                    <div class="text-muted small">Mutlu Yolcu</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 shadow-sm text-center h-100 py-4">
                    <div class="fs-2 fw-bold text-primary">7/24</div>
                    <div class="text-muted small">Destek</div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="mb-2"><i class="bi bi-bullseye text-primary" style="font-size:28px;"></i></div>
                        <h6>Misyonumuz</h6>
                        <p class="text-secondary small mb-0">Seyahati herkes için erişilebilir, şeffaf ve uygun fiyatlı kılmak.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="mb-2"><i class="bi bi-eye text-primary" style="font-size:28px;"></i></div>
                        <h6>Vizyonumuz</h6>
                        <p class="text-secondary small mb-0">Türkiye'nin en çok tercih edilen dijital seyahat platformu olmak.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="mb-2"><i class="bi bi-heart text-primary" style="font-size:28px;"></i></div>
                        <h6>Değerlerimiz</h6>
                        <p class="text-secondary small mb-0">Güven, şeffaflık, müşteri odaklılık ve sürekli yenilik.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a href="/Flight/Index" class="btn btn-lg" style="background:#1d4ed8; color:#fff;"><i class="bi bi-search"></i> Hemen Uçuş Ara</a>
        </div>

        <p class="text-muted small text-center mt-4">Bu sayfa örnek amaçlıdır ve staj projesi kapsamında hazırlanmıştır.</p>
    </div>
</div>
