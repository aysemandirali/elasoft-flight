@{
    var curCode = Context.Request.Cookies["cur"] ?? "TRY";
    var curLabel = curCode == "USD" ? "$ USD" : curCode == "EUR" ? "€ EUR" : "₺ TRY";
    var langCode = Context.Request.Cookies["lang"] ?? "tr";
    var ret = Context.Request.Path + Context.Request.QueryString;
    string RetEnc(string path) => Uri.EscapeDataString(path);
}
<style>
    .pref-dd { position: relative; display: inline-block; }
    .pref-dd > a { cursor: pointer; }
    .pref-menu {
        position: absolute; top: 100%; right: 0; min-width: 150px; background: #fff;
        border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.18); padding: 6px;
        display: none; z-index: 3000; margin-top: 6px;
    }
    .pref-dd:hover .pref-menu { display: block; }
    .pref-menu a {
        display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 7px;
        color: #334155 !important; font-size: 13.5px; text-decoration: none; white-space: nowrap;
    }
    .pref-menu a:hover { background: #f1f5f9; }
    .pref-menu a.active { color: #1d4ed8 !important; font-weight: 600; background: #eff6ff; }
    .pref-menu a.soon { opacity: .55; }
</style>
  <!-- preloader -->
<div id="preloader">
    <div id="loading-center">
        <div class="loader">
            <div class="loader-outter"></div>
            <div class="loader-inner"></div>
        </div>
    </div>
</div>
<!-- preloader-end -->
<!-- Scroll-top -->
<button class="scroll-top scroll-to-target" data-target="html">
    <i class="fas fa-angle-up"></i>
</button>
<!-- Scroll-top-end-->
<!-- header-area -->
<header>

    <div class="header-top">
        <div class="container custom-container">
            <div class="row">
                <div class="col-xl-4">
                    <div class="header-top-left">
                        <a href="#"><i class="fa-solid fa-tags"></i> Yaz Kampanyası: Yurt dışı uçuşlarda %30'a varan indirim!</a>
                    </div>
                </div>
                <div class="col-xl-8">
                    <div class="header-top-right">
                        <ul>
                            <li><a href="/Account/AdminLogin" style="font-weight:600;"><i class="fa-solid fa-shield-halved"></i> Yönetici Girişi</a></li>
                            <li class="pref-dd">
                                <a><i class="fa-solid fa-coins"></i> @curLabel <i class="fa-solid fa-angle-down" style="font-size:11px;"></i></a>
                                <div class="pref-menu">
                                    <a class="@(curCode == "TRY" ? "active" : "")" href="/Preferences/SetCurrency?code=TRY&returnUrl=@RetEnc(ret)">₺ Türk Lirası (TRY)</a>
                                    <a class="@(curCode == "USD" ? "active" : "")" href="/Preferences/SetCurrency?code=USD&returnUrl=@RetEnc(ret)">$ ABD Doları (USD)</a>
                                    <a class="@(curCode == "EUR" ? "active" : "")" href="/Preferences/SetCurrency?code=EUR&returnUrl=@RetEnc(ret)">€ Euro (EUR)</a>
                                </div>
                            </li>
                            <li class="pref-dd">
                                <a><i class="fa-solid fa-globe"></i> @(langCode == "en" ? "English" : "Türkçe") <i class="fa-solid fa-angle-down" style="font-size:11px;"></i></a>
                                <div class="pref-menu">
                                    <a class="@(langCode == "tr" ? "active" : "")" href="/Preferences/SetLanguage?code=tr&returnUrl=@RetEnc(ret)">🇹🇷 Türkçe</a>
                                    <a class="soon" title="İngilizce çeviri yakında" href="/Preferences/SetLanguage?code=en&returnUrl=@RetEnc(ret)">🇬🇧 English (yakında)</a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @await Component.InvokeAsync("_DefaultNavbarComponentPartial")
  
    
</header>
<!-- header-area-end -->
<!-- main-area -->