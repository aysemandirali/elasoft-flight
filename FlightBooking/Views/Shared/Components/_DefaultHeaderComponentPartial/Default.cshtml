@{
    var curCode = Context.Request.Cookies["cur"] ?? "TRY";
    var curLabel = curCode == "USD" ? "$ USD" : curCode == "EUR" ? "€ EUR" : "₺ TRY";
    var langCode = Context.Request.Cookies["lang"] ?? "tr";
    var ret = Context.Request.Path + Context.Request.QueryString;
    string RetEnc(string path) => Uri.EscapeDataString(path);

    // Gerçek SVG bayraklar (emoji bayraklar bazı tarayıcılarda render olmuyor)
    var trFlag = "<svg width='20' height='14' viewBox='0 0 30 20' style='border-radius:2px;vertical-align:middle;flex-shrink:0'><rect width='30' height='20' fill='#E30A17'/><circle cx='11.5' cy='10' r='4.6' fill='#fff'/><circle cx='13' cy='10' r='3.7' fill='#E30A17'/><polygon fill='#fff' points='17.8,7.1 18.48,9.06 20.56,9.1 18.9,10.36 19.51,12.35 17.8,11.16 16.09,12.35 16.7,10.36 15.04,9.1 17.12,9.06'/></svg>";
    var gbFlag = "<svg width='20' height='14' viewBox='0 0 60 40' style='border-radius:2px;vertical-align:middle;flex-shrink:0'><rect width='60' height='40' fill='#012169'/><path d='M0,0 60,40 M60,0 0,40' stroke='#fff' stroke-width='8'/><path d='M0,0 60,40 M60,0 0,40' stroke='#C8102E' stroke-width='4'/><path d='M30,0 V40 M0,20 H60' stroke='#fff' stroke-width='12'/><path d='M30,0 V40 M0,20 H60' stroke='#C8102E' stroke-width='7'/></svg>";
}
<style>
    .pref-dd { position: relative; display: inline-block; }
    .pref-dd > a {
        cursor: pointer; display: inline-flex !important; align-items: center; gap: 7px;
        color: #fff !important; font-weight: 500; opacity: .95;
    }
    .pref-dd > a:hover { opacity: 1; }
    .pref-dd .caret { font-size: 10px; opacity: .7; }
    .pref-menu a span { display: inline-flex; align-items: center; }
    .pref-menu .cur-sym {
        display: inline-flex; align-items: center; justify-content: center;
        width: 20px; height: 20px; background: #eff6ff; color: #1d4ed8; border-radius: 5px;
        font-weight: 700; font-size: 13px;
    }
    .pref-menu {
        position: absolute; top: 100%; right: 0; min-width: 150px; background: #fff;
        border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.18); padding: 6px;
        display: none; z-index: 3000; margin-top: 6px;
    }
    .pref-dd.open .pref-menu { display: block; }
    .pref-dd .caret { transition: transform .18s; }
    .pref-dd.open .caret { transform: rotate(180deg); }
    .pref-menu a {
        display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 7px;
        color: #334155 !important; font-size: 13.5px; text-decoration: none; white-space: nowrap;
    }
    .pref-menu a:hover { background: #f1f5f9; }
    .pref-menu a.active { color: #1d4ed8 !important; font-weight: 600; background: #eff6ff; }
    .pref-menu a.soon { opacity: .55; }
</style>
<script>
    // Para birimi / dil dropdown'u: tıklayınca açılır ve açık kalır (hover değil)
    document.addEventListener('click', function (e) {
        var trig = e.target.closest('.pref-trigger');
        if (trig) {
            e.preventDefault();
            var dd = trig.closest('.pref-dd');
            var wasOpen = dd.classList.contains('open');
            document.querySelectorAll('.pref-dd.open').forEach(function (d) { d.classList.remove('open'); });
            if (!wasOpen) dd.classList.add('open');
        } else if (!e.target.closest('.pref-menu')) {
            document.querySelectorAll('.pref-dd.open').forEach(function (d) { d.classList.remove('open'); });
        }
    });
</script>
  <!-- preloader -->
<div id="preloader">
    <div id="loading-center">
        <div class="loader">
            <div class="loader-outter"></div>
            <div class="loader-inner"></div>
        </div>
    </div>
</div>
<!-- preloader-end -->
<!-- Scroll-top -->
<button class="scroll-top scroll-to-target" data-target="html">
    <i class="fas fa-angle-up"></i>
</button>
<!-- Scroll-top-end-->
<!-- header-area -->
<header>

    <div class="header-top">
        <div class="container custom-container">
            <div class="row">
                <div class="col-xl-4">
                    <div class="header-top-left">
                        <a href="/Flight/Index"><i class="fa-solid fa-tags"></i> Yaz Kampanyası: Yurt dışı uçuşlarda %30'a varan indirim!</a>
                    </div>
                </div>
                <div class="col-xl-8">
                    <div class="header-top-right">
                        <ul>
                            <li><a href="/Account/AdminLogin" style="font-weight:600;"><i class="fa-solid fa-shield-halved"></i> Yönetici Girişi</a></li>
                            <li class="pref-dd">
                                <a class="pref-trigger" href="#" onclick="return false;"><i class="fa-solid fa-coins"></i> @curLabel <i class="fa-solid fa-angle-down caret"></i></a>
                                <div class="pref-menu">
                                    <a class="@(curCode == "TRY" ? "active" : "")" href="/Preferences/SetCurrency?code=TRY&returnUrl=@RetEnc(ret)"><span class="cur-sym">₺</span> Türk Lirası (TRY)</a>
                                    <a class="@(curCode == "USD" ? "active" : "")" href="/Preferences/SetCurrency?code=USD&returnUrl=@RetEnc(ret)"><span class="cur-sym">$</span> ABD Doları (USD)</a>
                                    <a class="@(curCode == "EUR" ? "active" : "")" href="/Preferences/SetCurrency?code=EUR&returnUrl=@RetEnc(ret)"><span class="cur-sym">€</span> Euro (EUR)</a>
                                </div>
                            </li>
                            <li class="pref-dd">
                                <a class="pref-trigger" href="#" onclick="return false;">@Html.Raw(langCode == "en" ? gbFlag : trFlag) <span>@(langCode == "en" ? "English" : "Türkçe")</span> <i class="fa-solid fa-angle-down caret"></i></a>
                                <div class="pref-menu">
                                    <a class="@(langCode == "tr" ? "active" : "")" href="/Preferences/SetLanguage?code=tr&returnUrl=@RetEnc(ret)">@Html.Raw(trFlag) <span>Türkçe</span></a>
                                    <a class="soon" title="İngilizce çeviri yakında" href="/Preferences/SetLanguage?code=en&returnUrl=@RetEnc(ret)">@Html.Raw(gbFlag) <span>English (yakında)</span></a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @await Component.InvokeAsync("_DefaultNavbarComponentPartial")
  
    
</header>
<!-- header-area-end -->
<!-- main-area -->