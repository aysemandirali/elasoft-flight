@model FlightBooking.Entities.TransferVehicle
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Transfer Rezervasyonu";
    ViewBag.PageTitle = "Transfer Rezervasyonu";
    ViewBag.PageSubtitle = Model.VehicleType;
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
    var from = ViewBag.From as string;
    var to = ViewBag.To as string;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="row g-4">

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div style="background:linear-gradient(120deg,#0f766e,#0ea5e9); color:#fff; padding:26px; text-align:center;">
                        <i class="bi @Model.Icon" style="font-size:52px;"></i>
                        <h4 class="mt-2 mb-0">@Model.VehicleType</h4>
                        <span class="small">@Model.Capacity kişiye kadar</span>
                    </div>
                    <div class="card-body">
                        <p class="text-secondary small">@Model.Description</p>
                        <ul class="list-unstyled m-0">
                            <li class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted"><i class="bi bi-people"></i> Kapasite</span><strong>@Model.Capacity kişi</strong></li>
                            <li class="d-flex justify-content-between py-2"><span class="text-muted"><i class="bi bi-cash"></i> Tek yön</span><strong>@Model.Price.ToString("#,##0", tr) ₺</strong></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="mb-3">Transfer Bilgileri</h5>
                        <form method="post" action="/Transfer/ReserveComplete">
                            <input type="hidden" name="vehicleId" value="@Model.Id" />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Nereden</label>
                                    <input name="fromLocation" value="@from" class="form-control" placeholder="İstanbul Havalimanı (IST)" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Nereye</label>
                                    <input name="toLocation" value="@to" class="form-control" placeholder="Taksim, İstanbul" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Tarih</label>
                                    <input type="date" name="date" min="@minDate" value="@minDate" class="form-control" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Saat</label>
                                    <input type="time" name="time" value="12:00" class="form-control" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Yolcu</label>
                                    <input type="number" name="passengerCount" min="1" max="@Model.Capacity" value="1" class="form-control" required />
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input type="hidden" name="roundTrip" value="false" />
                                        <input type="checkbox" name="roundTrip" value="true" id="rt" class="form-check-input" />
                                        <label for="rt" class="form-check-label">Gidiş-dönüş (çift yön, fiyat 2 katı)</label>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4" />
                            <h6 class="mb-3">İletişim Bilgileri</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Ad Soyad</label>
                                    <input name="customerName" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Telefon</label>
                                    <input name="customerPhone" class="form-control" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">E-posta</label>
                                    <input type="email" name="customerEmail" class="form-control" required />
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4 p-3 rounded" style="background:#ecfeff;">
                                <div>
                                    <div class="text-muted small" id="wayLabel">Tek yön</div>
                                    <div class="fs-3 fw-bold" style="color:#0f766e;"><span id="total">@Model.Price.ToString("#,##0", tr)</span> ₺</div>
                                </div>
                                <button class="btn btn-lg" style="background:#16a34a; color:#fff;"><i class="bi bi-check-circle"></i> Rezervasyonu Tamamla</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        var base = @Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture);
        document.getElementById('rt').addEventListener('change', function () {
            var total = this.checked ? base * 2 : base;
            document.getElementById('total').textContent = total.toLocaleString('tr-TR');
            document.getElementById('wayLabel').textContent = this.checked ? 'Gidiş-dönüş' : 'Tek yön';
        });
    </script>
}
